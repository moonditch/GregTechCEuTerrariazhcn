						OldString: ": need "
						NewString: ": 需要 "
					}
				}

				JoinCandidateNames: {
					1: {
						OldString: ""
						NewString: ""
					}

					2: {
						OldString: ", "
						NewString: ", "
					}

					3: {
						OldString: "' or "
						NewString: "' 或 "
					}

					4: {
						OldString: "' +"
						NewString: "' +"
					}

					5: {
						OldString: "' more"
						NewString: "' 更多"
					}
				}
			}

			PatternError+<ErrorDetailLines>d__11: {
				MoveNext: {
					1: {
						OldString: Wrong block at (
						NewString: 错误方块位于 (
					}

					2: {
						OldString: ", "
						NewString: ", "
					}

					3: {
						OldString: ") - found: "
						NewString: ") - 发现: "
					}

					4: {
						OldString: Expected one of:
						NewString: 预期为以下之一:
					}

					5: {
						OldString: "'  - "
						NewString: "'  - "
					}

					6: {
						OldString: "' (+"
						NewString: "' (+"
					}

					7: {
						OldString: "' more)"
						NewString: "' 更多)"
					}

					8: {
						OldString: "'  - ..."
						NewString: "'  - ..."
					}
				}
			}
		}
	}
}
