		GlobalRecipeBrowserState: {
			HintFor: {
				1: {
					OldString:
						'''
						Items mode: LMB = 1 * Shift+LMB / RMB = full stack * Alt+LMB = pin favorite
						Ctrl+LMB: cheat 1 to inventory  *  Ctrl+RMB: a full stack (Journey Mode)
						'''
					NewString:
						'''
						物品模式：左键 = 1个 * Shift+左键/右键 = 整组 * Alt+左键 = 收藏
						Ctrl+左键：作弊添加1个到背包  *  Ctrl+右键：整组（旅行模式）
						'''
				}

				2: {
					OldString:
						'''
						Equippable mode: LMB = 1 * Shift+LMB / RMB = full stack * Alt+LMB = pin favorite
						Ctrl+LMB: cheat 1 to inventory  *  Ctrl+RMB: a full stack (Journey Mode)
						'''
					NewString:
						'''
						装备模式：左键 = 1个 * Shift+左键/右键 = 整组 * Alt+左键 = 收藏
						Ctrl+左键：作弊添加1个到背包  *  Ctrl+右键：整组（旅行模式）
						'''
				}

				3: {
					OldString:
						'''
						Loot mode: hover an item and press R to scope to that item's vanilla sources
						Ctrl+LMB: cheat 1 to inventory  *  Ctrl+RMB: a full stack (Journey Mode)
						'''
					NewString:
						'''
						战利品模式：悬停物品并按R查看该物品的原始来源
						Ctrl+左键：作弊添加1个到背包  *  Ctrl+右键：整组（旅行模式）
						'''
				}

				4: {
					OldString:
						'''
						Tip: hover an item and press R (how to obtain) or U (used as ingredient)
						Ctrl+LMB: cheat 1 to inventory  *  Ctrl+RMB: a full stack (Journey Mode)
						'''
					NewString:
						'''
						提示：悬停物品并按R（如何获取）或U（用作材料）
						Ctrl+左键：作弊添加1个到背包  *  Ctrl+右键：整组（旅行模式）
						'''
				}
			}

