TerrariaCompat: {
	NPCs: {
		EBFChan: {
			EBFChanExportCommand: {
				get_Description: {
					1: {
						OldString: Dump the current character's appearance for baking a town NPC.
						NewString: 导出当前角色的外观以生成城镇NPC。
					}
				}
			}

			EBFChanSpawnSystem+EBFChanGenPass: {
				ApplyPass: {
					1: {
						OldString: Settling EBF-chan
						NewString: 安置EBF酱
					}
				}
			}
		}
	}

	UI: {
		CoverSettingsUI: {
			BuildSimpleFilter: {
				1: {
					OldString:
						'''
						Which direction the filter applies to
						Inv->Machine - filter items entering the machine from the adjacent inventory
						Machine->Inv - filter items leaving the machine into the adjacent inventory
						Both - filter both directions
						'''
					NewString:
						'''
						过滤器适用的方向
						容器->机器 - 过滤从相邻容器进入机器的物品
						机器->容器 - 过滤从机器进入相邻容器的物品
						两者 - 过滤两个方向
						'''
				}

				2: {
					OldString:
						'''
						Behaviour for the direction the filter doesn't apply to
						Block - no flow in that direction
						Filter - apply the filter in that direction too
						Free - pass everything through unchecked
						'''
					NewString:
						'''
						过滤器不适用的方向的行为
						阻止 - 该方向无流通
						过滤 - 在该方向也应用过滤器
						自由 - 不检查直接通过所有物品
						'''
				}
			}

			FilterModeName: {
				1: {
					OldString: Inv->Machine
					NewString: 容器->机器
				}

				2: {
					OldString: Machine->Inv
					NewString: 机器->容器
				}

				3: {
					OldString: Both
					NewString: 两者
				}

				4: {
					OldString: ?
					NewString: ?
				}
			}

			BuildAdvancedVoiding: {
				1: {
					OldString:
						'''
						Voiding mode
						Void Any - delete everything
						Void Overflow - keep the limit, delete the surplus
						'''
					NewString:
						'''
						销毁模式
						Void Any - 删除所有物品
						Void Overflow - 保留上限，删除多余物品
						'''
				}

				2: {
					OldString:
						'''
						VoidOverflow keep-limit (kept per type)
						L +  *  R -  *  hold Shift for a bigger step
						'''
					NewString:
						'''
						VoidOverflow 保留上限（按类型保留）
						左键 +  *  右键 -  *  按住 Shift 以更大步进
						'''
				}
			}

			BuildMachineController: {
				1: {
					OldString: What this cover enables / disables - the host machine, or a cover on one of its sides
					NewString: 此面板启用/禁用的对象 - 主机或其某一侧的面板
				}

				2: {
					OldString: Invert the wire signal - by default a pulse pauses the target; inverted, a pulse runs it
					NewString: 反转线缆信号 - 默认脉冲暂停目标；反转后脉冲启动目标
				}

				3: {
					OldString: Keep the target machine from suspending when it runs out of power mid-recipe
					NewString: 防止目标机器在配方中途耗尽能量时暂停
				}
			}

			ControllerModeName: {
				1: {
					OldString: this machine
					NewString: 此机器
				}

				2: {
					OldString: cover (up)
					NewString: 面板（上）
				}

				3: {
					OldString: cover (down)
					NewString: 面板（下）
				}

				4: {
					OldString: cover (left)
					NewString: 面板（左）
				}

				5: {
					OldString: cover (right)
					NewString: 面板（右）
				}

				6: {
					OldString: ?
					NewString: ?
				}
			}

			BuildAdvancedDetector: {
				1: {
					OldString: Invert the emitted signal
					NewString: 反转发出的信号
				}

				2: {
					OldString: Lower threshold  *  L +  *  R -  *  hold Shift for a bigger step
					NewString: 下限  *  左键 +  *  右键 -  *  按住 Shift 以更大步进
				}

				3: {
					OldString: Upper threshold  *  L +  *  R -  *  hold Shift for a bigger step
					NewString: 上限  *  左键 +  *  右键 -  *  按住 Shift 以更大步进
				}

				4: {
					OldString: Compare stored EU as a percentage of capacity, or as a raw EU amount
					NewString: 将存储的EU按容量百分比或原始EU量进行比较
				}

				5: {
					OldString: Latched output - holds until the value crosses the opposite threshold
					NewString: 锁存输出 - 保持直到值越过相反的阈值
				}
			}

			BuildEnderLink: {
				1: {
					OldString: channel (8 hex)
					NewString: 频道（8位十六进制）
				}

				2: {
					OldString:
						'''
						Ender channel - a hex code: digits 0-9 and letters A-F only.
						Up to 8 characters; anything shorter is padded with F
						(so '1A2B' becomes '1A2BFFFF').
						Type, then press Enter (or click away) to set.
						'''
					NewString:
						'''
						Ender频道 - 十六进制代码：仅限数字0-9和字母A-F。
						最多8个字符；较短字符将以F填充
						（例如'1A2B'变为'1A2BFFFF'）。
						输入后按回车（或点击其他位置）以设置。
						'''
				}

				3: {
					OldString:
						'''
						Import - pull from the host machine into the channel
						Export - push from the channel into the host machine
						'''
					NewString:
						'''
						导入 - 从主机拉取到频道
						导出 - 从频道推送到主机
						'''
				}

				4: {
					OldString: Channel
					NewString: 频道
				}
			}

			BuildIOCover: {
				1: {
					OldString:
						'''
						Import - pull from the adjacent inventory into this machine
						Export - push from this machine into the adjacent inventory
						'''
					NewString:
						'''
						输入 - 从相邻容器输入到本机器
						输出 - 从本机器输出到相邻容器
						'''
				}

				2: {
					OldString:
						'''
						How transfer behaves on the filter's non-filtered direction:
						Disabled - blocked  *  Filtered - the filter applies  *  Unfiltered - all pass
						'''
					NewString:
						'''
						过滤器未应用方向上的传输行为：
						Disabled - 阻止  *  Filtered - 应用过滤器  *  Unfiltered - 全部通过
						'''
				}

				3: {
					OldString: Transfer rate  *  L +  *  R -  *  hold Shift for a bigger step
					NewString: 传输速率  *  左键 +  *  右键 -  *  按住 Shift 以更大步进
				}

				4: {
					OldString: Display unit for the transfer rate above
					NewString: 上述传输速率的显示单位
				}

				5: {
					OldString:
						'''
						Any - move whatever fits
						Exact - move only whole configured per-type stacks
						Keep Exact - top the target up to the configured per-type amount
						'''
					NewString:
						'''
						Any - 移动任何适合的物品
						Exact - 仅移动已配置的完整每组数量
						Keep Exact - 将目标补充至已配置的每组数量
						'''
				}

				6: {
					OldString: per-type limit
					NewString: 每类型限制
				}

				7: {
					OldString: Per-type amount used by the Exact / Keep Exact modes
					NewString: Exact/Keep Exact模式使用的每类型数量
				}

				8: {
					OldString: ""
					NewString: ""
				}

				9: {
					OldString: "'  (in mB)"
					NewString: "'  (以mB为单位)"
				}
			}

			ManualIoName: {
				1: {
					OldString: Block
					NewString: 阻止
				}

				2: {
					OldString: Filter
					NewString: 过滤
				}

				3: {
					OldString: Free
					NewString: 自由
				}

				4: {
					OldString: ?
					NewString: ?
				}
			}

			RateLabel: {
				1: {
					OldString: "Transfer rate: "
					NewString: "传输速率："
				}

				2: {
					OldString: "' /t"
					NewString: "' /t"
				}

				3: {
					OldString: "' mB/t"
					NewString: "' mB/t"
				}

				4: {
					OldString: "' B/t"
					NewString: "' B/t"
				}
			}

			TransferModeName: {
				1: {
					OldString: Any
					NewString: 任意
				}

				2: {
					OldString: Exact
					NewString: 精确
				}

				3: {
					OldString: Keep Exact
					NewString: 保持精确
				}

				4: {
					OldString: ?
					NewString: ?
				}
			}

			BuildShutter: {
				1: {
					OldString:
						'''
						Closed - no items / fluids may pass this side
						Open - transfer flows normally
						'''
					NewString:
						'''
						关闭 - 物品/流体无法通过此侧
						打开 - 正常传输
						'''
				}
			}

			AppendFilterBlock: {
				1: {
					OldString: Filter item
					NewString: 过滤物品
				}

				2: {
					OldString: tag expression  *  e.g.  *dusts/gold | !*lv
					NewString: 标签表达式  *  例如  *dusts/gold | !*lv
				}

				3: {
					OldString:
						'''
						Accepts complex expressions:
						a & b = AND   *   a | b = OR   *   a ^ b = XOR
						!a = NOT   *   (a) for grouping
						* = wildcard   *   $ = untagged
						Tags are 'namespace:tag/subtype'.
						The 'forge:' namespace is assumed if one isn't given.
						Example: *dusts/gold | (gtceu:circuits & !*lv)
						matches all gold dusts, or all circuits except LV ones.
						Type, then press Enter (or click away) to set.
						'''
					NewString:
						'''
						支持复杂表达式：
						a & b = 与   *   a | b = 或   *   a ^ b = 异或
						!a = 非   *   (a) 分组
						* = 通配符   *   $ = 未标记
						标签格式为'命名空间:标签/子类型'。
						如未指定命名空间，默认为'forge:'。
						示例：*dusts/gold | (gtceu:circuits & !*lv)
						匹配所有金粉，或除LV外的所有电路。
						输入后按回车（或点击其他位置）以设置。
						'''
				}

				4: {
					OldString:
						'''
						Whitelist - only listed types pass
						Blacklist - listed types are blocked
						'''
					NewString:
						'''
						白名单 - 仅列出的类型通过
						黑名单 - 列出的类型被阻止
						'''
				}

				5: {
					OldString: Ignore item / fluid NBT data when matching
					NewString: 匹配时忽略物品/流体NBT数据
				}
			}

			Title: {
				1: {
					OldString: Cover
					NewString: 面板
				}

				2: {
					OldString: "'  *  "
					NewString: "'  *  "
				}
			}
		}

