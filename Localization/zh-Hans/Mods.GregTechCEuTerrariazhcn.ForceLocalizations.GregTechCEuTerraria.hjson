						OldString:
							'''
							' pass
							Blacklist - listed 
							'''
						NewString:
							'''
							' 通过
							黑名单 - 列出 
							'''
					}

					8: {
						OldString:
							'''
							' are blocked
							(an empty whitelist blocks everything; default for fresh Active sides)
							'''
						NewString:
							'''
							' 被阻止
							（空白名单阻止所有物品；新激活侧面的默认设置）
							'''
					}

					9: {
						OldString: e.g. *dusts/iron
						NewString: 例如 *dusts/iron
					}

					10: {
						OldString:
							'''
							Accepts complex expressions:
							a & b = AND   *   a | b = OR   *   a ^ b = XOR
							!a = NOT   *   (a) for grouping
							* = wildcard   *   $ = untagged
							Tags are 'namespace:tag/subtype' (forge: assumed by default).
							Type, then press Enter (or click away) to set.
							'''
						NewString:
							'''
							支持复杂表达式：
							a & b = 与   *   a | b = 或   *   a ^ b = 异或
							!a = 非   *   (a) 用于分组
							* = 通配符   *   $ = 无标签
							标签格式为'命名空间:标签/子类型'（默认使用forge:）。
							输入后按Enter（或点击其他地方）以设置。
							'''
					}

					11: {
						OldString:
							'''
							Which direction the filter applies to
							Inv->Pipe - filter 
							'''
						NewString:
							'''
							过滤器适用的方向
							容器->管道 - 过滤 
							'''
					}

					12: {
						OldString:
							'''
							' entering the pipe from the connected inventory
							Pipe->Inv - filter 
							'''
						NewString:
							'''
							' 从连接的容器进入管道
							管道->容器 - 过滤 
							'''
					}

					13: {
						OldString:
							'''
							' leaving the pipe into the connected inventory
							Both - filter both directions
							'''
						NewString:
							'''
							' 从管道进入连接的容器
							两者 - 过滤两个方向
							'''
					}

					14: {
						OldString:
							'''
							Behaviour for the direction the filter doesn't apply to
							Block - no flow in that direction
							Filter - apply the filter in that direction too
							Free - pass everything through unchecked
							'''
						NewString:
							'''
							过滤器不适用的方向的行为
							阻止 - 该方向无流通
							过滤 - 在该方向也应用过滤器
							自由 - 不检查直接通过所有物品
							'''
					}
				}

